import SwiftUI

// The Router's state filter, a DAW mixer's: every state (Needs you, Worth a look, Waiting, Working and, on the canvas, Done)
// can be soloed or muted. One value on the Router's model, so the list and the canvas show the same things.

/// Which states show. Solo wins, as on a mixer: while any state is soloed only the soloed ones show, whatever is muted;
/// otherwise every state shows but the muted ones.
struct RouterFilter: Equatable {
    var solo: Set<CanvasGroup> = []
    var mute: Set<CanvasGroup> = []

    /// Nothing soloed or muted: everything shows.
    var isClear: Bool { solo.isEmpty && mute.isEmpty }

    func shows(_ group: CanvasGroup) -> Bool {
        solo.isEmpty ? !mute.contains(group) : solo.contains(group)
    }

    func shows(_ zone: RouterZone) -> Bool { shows(CanvasGroup(zone)) }

    mutating func toggleSolo(_ group: CanvasGroup) {
        if solo.contains(group) { solo.remove(group) } else { solo.insert(group) }
    }

    mutating func toggleMute(_ group: CanvasGroup) {
        if mute.contains(group) { mute.remove(group) } else { mute.insert(group) }
    }

    mutating func clear() { self = RouterFilter() }

    /// Makes `group` show (a pick into it): unmuted, and joined to the solos when there are some.
    mutating func reveal(_ group: CanvasGroup) {
        mute.remove(group)
        if !solo.isEmpty { solo.insert(group) }
    }
}

extension CanvasGroup {
    init(_ zone: RouterZone) {
        switch zone {
        case .needs: self = .needs
        case .notes: self = .notes
        case .waiting: self = .waiting
        case .working: self = .working
        }
    }
}

extension RouterPage {
    /// The page with the sections the filter hides emptied: what the list draws and the keys walk.
    func filtered(_ filter: RouterFilter) -> RouterPage {
        if filter.isClear { return self }
        var page = self
        if !filter.shows(.needs) { page.needs = []; page.ready = []; page.asks = [] }
        if !filter.shows(.notes) { page.notes = [] }
        if !filter.shows(.waiting) { page.waiting = [] }
        if !filter.shows(.working) { page.working = [] }
        return page
    }
}

extension RouterModel {
    /// The list's page: Now as the search and the filter leave it.
    func listZones(_ store: Store) -> RouterPage { zones(store).filtered(filter) }
}

// MARK: - Chips

/// The state chips, in a row, and Clear after them while a solo or a mute is set. The list and the canvas draw the same.
struct RouterFilterRow: View {
    let model: RouterModel
    let counts: [(CanvasGroup, Int)]
    let named: Bool
    var overview: String? = nil
    @Environment(\.accessibilityReduceMotion) private var reduceMotion

    var body: some View {
        HStack(spacing: 4) {
            ForEach(counts, id: \.0) { group, count in
                StateChip(group: group, count: count, named: named, solo: model.filter.solo.contains(group),
                          muted: model.filter.mute.contains(group), overview: group == .working ? overview : nil,
                          soloAction: { apply { $0.toggleSolo(group) } }, muteAction: { apply { $0.toggleMute(group) } })
                    .flightTarget(group.zone.map { "chip:\($0.rawValue)" })
            }
            if !model.filter.isClear {
                ClearFilterButton { apply { $0.clear() } }
            }
        }
        .fixedSize()
    }

    private func apply(_ change: (inout RouterFilter) -> Void) {
        withAnimation(Motion.spatial.resolved(reduce: reduceMotion)) { change(&model.filter) }
    }
}

/// A state's chip: its glyph, name and count (a click solos it), and the S and M buttons of a mixer channel.
struct StateChip: View {
    let group: CanvasGroup
    let count: Int
    let named: Bool
    let solo: Bool
    let muted: Bool
    var overview: String? = nil
    let soloAction: () -> Void
    let muteAction: () -> Void
    @State private var hovered = false

    var body: some View {
        HStack(spacing: 0) {
            Button(action: soloAction) {
                HStack(spacing: 4) {
                    CanvasGroupGlyph(group: group)
                    if named {
                        Text(group.title).cdsText((12, 16), .regular, hovered || solo ? CDS.Text.primary : CDS.Text.secondary)
                    }
                    Text("\(count)").cdsText((12, 16), .medium, group == .needs ? CDS.Fill.warning : CDS.Text.muted).monospacedDigit()
                }
                .padding(.leading, 7)
                .padding(.trailing, 4)
                .frame(height: ZoneChip.height)
                .contentShape(Rectangle())
            }
            .buttonStyle(.plain)
            .onHover { hovered = $0 }
            .help(overview ?? (solo ? "Unsolo \(group.title)" : "Solo \(group.title)"))
            .accessibilityLabel("\(group.title), \(count)")
            .accessibilityValue(solo ? "Solo" : muted ? "Muted" : "")
            .accessibilityHint(solo ? "Shows the other states again" : "Shows only it")
            .opacity(muted && !solo ? 0.5 : 1)

            HStack(spacing: 2) {
                MixerButton(letter: "S", on: solo, tint: CDS.Fill.accent, label: "Solo \(group.title)",
                            help: solo ? "Unsolo" : "Solo: show only the soloed states", action: soloAction)
                MixerButton(letter: "M", on: muted, tint: CDS.Fill.warning, label: "Mute \(group.title)",
                            help: muted ? "Unmute" : "Mute: hide \(group.title)", action: muteAction)
            }
            .padding(.trailing, 3)
        }
        .background(Capsule().fill(solo ? CDS.Fill.secondary : hovered ? CDS.Fill.ghostHover : CDS.alpha(0.04)))
        .overlay { if solo { Capsule().strokeBorder(CDS.border, lineWidth: 1) } }
    }
}

/// The S or M of a chip: a small square, filled while on.
private struct MixerButton: View {
    let letter: String
    let on: Bool
    let tint: Color
    let label: String
    let help: String
    let action: () -> Void
    @State private var hovered = false

    var body: some View {
        Button(action: action) {
            Text(letter)
                .font(CDS.sans(9, .bold))
                .foregroundStyle(on ? Color.white : hovered ? CDS.Text.primary : CDS.Text.muted)
                .frame(width: 14, height: 14)
                .background(RoundedRectangle(cornerRadius: 4).fill(on ? tint : hovered ? CDS.Fill.ghostHover : Color.clear))
                .contentShape(Rectangle())
        }
        .buttonStyle(.plain)
        .onHover { hovered = $0 }
        .help(help)
        .accessibilityLabel(label)
        .accessibilityValue(on ? "On" : "Off")
        .accessibilityAddTraits(on ? .isSelected : [])
    }
}

/// Clear, after the chips: every solo and mute off.
private struct ClearFilterButton: View {
    let action: () -> Void
    @State private var hovered = false

    var body: some View {
        Button(action: action) {
            Text("Clear").cdsText((12, 16), .regular, hovered ? CDS.Text.primary : CDS.Text.muted)
                .padding(.horizontal, 7)
                .frame(height: ZoneChip.height)
                .contentShape(Capsule())
        }
        .buttonStyle(.plain)
        .onHover { hovered = $0 }
        .help("Show every state again")
        .accessibilityLabel("Clear solo and mute")
    }
}
